{
  // == Run with (Claude needs an extra step — see README_nono.md §3/§5) ==
  // macOS can't read Keychain from inside the sandbox, so pull the token out first:
  // security find-generic-password -a "$USER" -s "Claude Code-credentials" -w \
  //   > ~/.claude/.credentials.json && chmod 600 ~/.claude/.credentials.json
  // nono run --profile ./nono/claude-mac.jsonc --allow-cwd -- claude --dangerously-skip-permissions "$@"
  // == Put in central profile ==
  // mkdir -p ~/.config/nono/profiles
  // cp nono/claude-mac.jsonc ~/.config/nono/profiles/claude-mac.jsonc
  // nono run --profile claude-mac --allow-cwd -- claude --dangerously-skip-permissions "$@"

  "extends": "default",
  "meta": {
    "name": "claude-mac",
    "version": "1.0.0",
    "description": "Claude Code, macOS sandbox"
  },
  "groups": {
    "include": ["node_runtime", "python_runtime", "go_runtime", "git_config"]
    // see more https://nono.sh/docs/cli/features/profiles-groups
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    // Broad parent paths are safe on macOS — seatbelt (unlike Landlock on Linux)
    // can enforce deny-within-allow so no overlap conflicts arise.
    "read": [
      "$HOME/.config",      // app/tool configs (npm, etc.)
      "$HOME/.local/share", // app data (node, python, etc.)
      "$HOME/Library"       // macOS app support dirs (frameworks, caches)
    ],
    "allow": [
      "$HOME/.cache",
      "$HOME/.agents",
      "/tmp",
      "$HOME/.claude"       // config, history, AND auth
    ],
    "allow_file": [
      "$HOME/.claude.json",        // top-level Claude Code config (model, theme, etc.)
      "$HOME/.claude.json.lock",   // held during config reads; must be visible to avoid ENOENT
      "$HOME/.CFUserTextEncoding", // macOS locale/encoding bootstrap
      "$HOME/.local/bin/claude"    // the Claude Code binary itself
    ],
    "write_file": [
      "$HOME/.claude.lock"         // Claude writes this on startup for concurrent-instance detection
    ],
    // Paths Claude Code touches at shutdown that we want silently denied — no interactive
    // review prompt. Browser dirs are already blocked by deny_browser_data_* groups.
    "suppress_save_prompt": [
      "$HOME",
      "$HOME/Applications/Claude Code URL Handler.app",
      "$HOME/Applications/Claude Code URL Handler.app/Contents/MacOS/claude",
      "$HOME/Library/Application Support/Arc/User Data",
      "$HOME/Library/Application Support/BraveSoftware/Brave-Browser",
      "$HOME/Library/Application Support/Chromium",
      "$HOME/Library/Application Support/Google/Chrome",
      "$HOME/Library/Application Support/Microsoft Edge",
      "$HOME/Library/Application Support/Vivaldi",
      "$HOME/Library/Application Support/com.operasoftware.Opera",
      "/home"
    ]
  },
  "environment": {
    "allow_vars": ["PATH", "HOME", "TERM", "LANG"]
  },
  "network": {
    // Only Anthropic endpoints — everything else (curl, git push/pull, etc.) is blocked
    "allow_domain": [
      "claude.ai",         // web UI / auth flows
      "api.anthropic.com"  // inference API
    ]
  },
  // CFPreferences/NSUserDefaults (locale, timezone) read at startup
  "unsafe_macos_seatbelt_rules": [
    "(allow user-preference-read)"
  ],
  "allow_launch_services": true,   // required for Claude Code to open URLs (browser-based auth, etc.)
  "interactive": true
}
