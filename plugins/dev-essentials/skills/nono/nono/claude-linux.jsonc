{
  // == Run with (see README_nono.md §3) ==
  // Linux stores creds in plain ~/.claude/.credentials.json, already inside the
  // $HOME/.claude grant below — no extraction step needed, unlike claude-mac.
  // nono run --profile ./nono/claude-linux.jsonc --no-diagnostics --allow-cwd -- claude --dangerously-skip-permissions
  // == Put in central profile ==
  // mkdir -p ~/.config/nono/profiles
  // cp nono/claude-linux.jsonc ~/.config/nono/profiles/claude-linux.jsonc
  // nono run --profile claude-linux --no-diagnostics --allow-cwd -- claude --dangerously-skip-permissions

  "extends": "default",
  "meta": {
    "name": "claude-linux",
    "version": "1.0.0",
    "description": "Claude Code, Linux sandbox"
  },
  "groups": {
    "include": ["node_runtime", "python_runtime", "go_runtime", "git_config"]
    // see more https://nono.sh/docs/cli/features/profiles-groups
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    // Read-only. Intentionally NOT "$HOME/.config" or "$HOME/.local/share" — broad
    // parent grants conflict with deny rules from the default profile on Linux (Landlock
    // can't enforce deny-within-allow). Enumerate specific subdirs instead.
    "read": [
      "/proc",
      "/opt/google/chrome/",
      "$HOME/.config/npm",         // npm config
      "$HOME/.local/share/npm",    // npm global data
      "$HOME/.local/share/node_modules"
    ],
    "allow": [
      "$HOME/.cache",
      "$HOME/.agents",
      "$HOME/.config/google-chrome/",
      "/tmp",
      "$HOME/.claude"              // config, history, and credentials (Linux uses plain file, no keyring)
    ],
    "allow_file": [
      "$HOME/.claude.json",        // top-level Claude Code config (model, theme, etc.)
      "$HOME/.claude.json.lock",   // held during config reads; must be visible to avoid ENOENT
      "$HOME/.local/bin/claude"    // the Claude Code binary itself
    ],
    "write_file": [
      "$HOME/.claude.lock"         // Claude writes this on startup for concurrent-instance detection
    ]
  },
  "environment": {
    "allow_vars": ["PATH", "HOME", "TERM", "LANG"]
  },
  "network": {
    // Only Anthropic/Claude endpoints — everything else (curl, git push/pull, etc.) is blocked
    "allow_domain": [
      "claude.ai",           // web UI / auth flows
      "claude.com",          // OAuth2 authorize endpoint (current login flow)
      "platform.claude.com", // OAuth2 code exchange endpoint
      "api.anthropic.com"    // inference API
    ]
  },
  // Supervisor-delegated browser opening for `claude login`. On Linux nono delegates
  // approved URLs to the unsandboxed parent process — no --allow-launch-services needed.
  // See README_nono.md §3 and https://nono.sh/docs/cli/clients/claude-code#oauth2-login
  "open_urls": {
    "allow_origins": ["https://claude.ai", "https://claude.com"],
    "allow_localhost": true
  },
  "interactive": true
}
