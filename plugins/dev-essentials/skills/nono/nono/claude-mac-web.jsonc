{
  // == Run with (Claude needs an extra step — see README_nono.md §3-5) ==
  // macOS can't read Keychain from inside the sandbox, so pull the token out first:
  // security find-generic-password -a "$USER" -s "Claude Code-credentials" -w \
  //   > ~/.claude/.credentials.json && chmod 600 ~/.claude/.credentials.json
  // nono run --profile ./nono/claude-mac-web.jsonc --allow-cwd -- claude --dangerously-skip-permissions "$@"
  // == Put in central profile ==
  // mkdir -p ~/.config/nono/profiles
  // cp nono/claude-mac-web.jsonc ~/.config/nono/profiles/claude-mac-web.jsonc
  // nono run --profile claude-mac-web --allow-cwd -- claude --dangerously-skip-permissions "$@"

  "extends": "default",
  "meta": {
    "name": "claude-mac-web",
    "version": "1.0.0",
    "description": "Claude Code, macOS sandbox, unrestricted outbound network"
  },
  "groups": {
    "include": ["node_runtime", "python_runtime", "go_runtime", "git_config"]
    // see more https://nono.sh/docs/cli/features/profiles-groups
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    // Broad parent paths are safe on macOS — seatbelt (unlike Landlock on Linux)
    // can enforce deny-within-allow so no overlap conflicts arise.
    "read": [
      "$HOME/.config",      // app/tool configs (npm, etc.)
      "$HOME/.local/share", // app data (node, python, etc.)
      "$HOME/Library"       // macOS app support dirs (frameworks, caches)
    ],
    "allow": [
      "$HOME/.cache",
      "$HOME/.agents",
      "/tmp",
      "$HOME/.claude"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.CFUserTextEncoding",
      "$HOME/.local/bin/claude"
    ],
    "write_file": [
      "$HOME/.claude.lock"
    ]
  },
  "environment": {
    "allow_vars": ["PATH", "HOME", "TERM", "LANG"]
  },
  // No allow_domain — leaves network unrestricted so WebSearch/WebFetch, npm/pip
  // installs, arbitrary curl, etc. all work.
  //
  // CAUTION: removes the network egress guardrail. Filesystem/command restrictions
  // still apply, but a prompt-injected agent can now reach any host. Prefer
  // claude-mac.jsonc unless you specifically need open web access.
  "network": {
    "block": false
  },
  "unsafe_macos_seatbelt_rules": [
    "(allow user-preference-read)"
  ],
  "allow_launch_services": true,
  "interactive": true
}
