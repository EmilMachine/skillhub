{
  // == Run with (see README_nono.md §3-4) ==
  // Linux stores creds in plain ~/.claude/.credentials.json, already inside the
  // $HOME/.claude grant below — no extraction step needed, unlike claude-mac-web.
  // nono run --profile ./nono/claude-linux-web.jsonc --no-diagnostics --allow-cwd -- claude --dangerously-skip-permissions
  // == Put in central profile ==
  // mkdir -p ~/.config/nono/profiles
  // cp nono/claude-linux-web.jsonc ~/.config/nono/profiles/claude-linux-web.jsonc
  // nono run --profile claude-linux-web --no-diagnostics --allow-cwd -- claude --dangerously-skip-permissions

  "extends": "default",
  "meta": {
    "name": "claude-linux-web",
    "version": "1.0.0",
    "description": "Claude Code, Linux sandbox, unrestricted outbound network"
  },
  "groups": {
    "include": ["node_runtime", "python_runtime", "go_runtime", "git_config"]
    // see more https://nono.sh/docs/cli/features/profiles-groups
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    // Read-only. Intentionally NOT "$HOME/.config" or "$HOME/.local/share" — broad
    // parent grants conflict with deny rules from the default profile on Linux (Landlock
    // can't enforce deny-within-allow). Enumerate specific subdirs instead.
    "read": [
      "/proc",
      "/opt/google/chrome/",
      "$HOME/.config/npm",         // npm config
      "$HOME/.local/share/npm",    // npm global data
      "$HOME/.local/share/node_modules"
    ],
    "allow": [
      "$HOME/.cache",
      "$HOME/.agents",
      "$HOME/.config/google-chrome/",
      "/tmp",
      "$HOME/.claude"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.local/bin/claude"
    ],
    "write_file": [
      "$HOME/.claude.lock"
    ]
  },
  "environment": {
    "allow_vars": ["PATH", "HOME", "TERM", "LANG"]
  },
  // No allow_domain — leaves network unrestricted so WebSearch/WebFetch, npm/pip
  // installs, arbitrary curl, etc. all work.
  //
  // CAUTION: removes the network egress guardrail. Filesystem/command restrictions
  // still apply, but a prompt-injected agent can now reach any host. Prefer
  // claude-linux.jsonc unless you specifically need open web access.
  "network": {
    "block": false
  },
  // Supervisor-delegated browser opening for `claude login`. On Linux nono delegates
  // approved URLs to the unsandboxed parent process — no --allow-launch-services needed.
  // See README_nono.md §3 and https://nono.sh/docs/cli/clients/claude-code#oauth2-login
  "open_urls": {
    "allow_origins": ["https://claude.ai", "https://claude.com"],
    "allow_localhost": true
  },
  "interactive": true
}
